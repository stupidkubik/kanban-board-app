{
  "name": "kanban-board-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && npm run check:server-trace",
    "check:server-trace": "node scripts/check-server-trace.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "eslint . --fix",
    "smoke": "node scripts/smoke-kanban.mjs",
    "migrate:stale-member-profiles": "node scripts/migrate-stale-member-profiles.mjs",
    "migrate:card-labels": "node scripts/migrate-card-labels.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit tests/components",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/firestore\"",
    "cypress:open": "firebase emulators:exec --project demo-kanban-e2e --only auth,firestore \"node scripts/run-cypress-e2e.mjs --open\"",
    "cypress:run": "firebase emulators:exec --project demo-kanban-e2e --only auth,firestore \"node scripts/run-cypress-e2e.mjs\"",
    "check": "npm run lint -- --max-warnings 0 && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@reduxjs/toolkit": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.6.0",
    "next": "^16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-redux": "^9.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cypress": "^15.21.1",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "firebase-tools": "^15.34.2",
    "jsdom": "^27.4.0",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "google-gax": {
      "uuid": "^11.1.1"
    },
    "teeny-request": {
      "uuid": "^11.1.1"
    }
  }
}
